{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [{ "type": "command", "command": "figure hook guard", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "figure hook stop", "timeout": 30 }]
      }
    ]
  }
}
